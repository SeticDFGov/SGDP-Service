<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>  
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>  
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
    <!-- XLSX das planilhas da Governança Estratégica (licença MIT); ver CLAUDE.md -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Enums.NET" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.13" />
    <PackageReference Include="Microsoft.Graph" Version="5.71.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.68.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Novell.Directory.Ldap.NETStandard" Version="4.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="QuestPDF" Version="2025.7.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.DirectoryServices" Version="8.0.0" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.1" />
    <PackageReference Include="TimeZoneConverter" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="service\consts\" />
  </ItemGroup>

  <!-- Governança Estratégica: modelo inicial (trilha e campos do PDTIC) embutido no
       assembly, lido pelo PeCarregadorModelo; não vai como arquivo solto na publicação -->
  <ItemGroup>
    <Content Remove="Models\Planejamento\Seed\**" />
    <None Remove="Models\Planejamento\Seed\**" />
    <EmbeddedResource Include="Models\Planejamento\Seed\modelo-inicial.json" LogicalName="Planejamento.modelo-inicial.json" />
    <!-- Modelo do documento do PDTIC (E5): capítulos, textos padrão e blocos de dados -->
    <EmbeddedResource Include="Models\Planejamento\Seed\documento-inicial.json" LogicalName="Planejamento.documento-inicial.json" />
    <!-- Fluxos do guia como modelo (E6): figuras 4 a 22, com raias, passos, decisões e artefatos -->
    <EmbeddedResource Include="Models\Planejamento\Seed\fluxos-inicial.json" LogicalName="Planejamento.fluxos-inicial.json" />
  </ItemGroup>




</Project>
